{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main, pet and popped-out view windows",
  "windows": [
    "main",
    "pet",
    "view-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "core:window:allow-start-dragging",
    "opener:default",
    "log:default",
    "updater:default",
    "process:default",
    "notification:default",
    "dialog:default",
    "autostart:default"
  ]
}
